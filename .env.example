# Copy to .env and fill values for production integrations.

PORT=3000
JWT_SECRET=change-me-in-production

# Stripe — card pre-authorization (PaymentIntents, optional webhook)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio — SMS to recipient (E.164 numbers, e.g. +37061234567)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase Cloud Messaging (FCM) — firebase-admin (recommended)
# Use the service account JSON from Firebase Console → Project settings → Service accounts.
# Either set a path, or paste the whole JSON (single line) into FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or standard Google env:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# Legacy (not used by current code path; kept for reference)
FIREBASE_SERVER_KEY=
